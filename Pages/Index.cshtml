@page
@model IndexModel
@{
    ViewData["Title"] = "Sök bok";
}

    <section class="flex flex-col text-center bg-surface-container-low p-14 rounded-lg shadow-md">
        <h1 class="mb-6">Vad vill du läsa idag?</h1>
        <!-- Sökfält -->
        <form method="get">
            <div class="relative w-full lg:w-2/3 mx-auto mb-4">
                <label name="" class="sr-only">Sök</label>
                <!-- Input-fältet -->
                <input 
                    type="search" 
                    id="book-search"
                    name="query" 
                    placeholder="Sök på titel, serie, författare eller ISBN" 
                    class="relative w-full rounded-2xl border border-container-low-border bg-white py-4 pl-6 pr-25 text-md placeholder:text-text-muted focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" 
                />

                <!-- Sökknapp (höger) -->
                <button 
                    type="submit" 
                    aria-label="Sök"
                    class="absolute right-2 top-1/2 -translate-y-1/2 flex items-center bg-primary rounded-2xl px-3 py-1.5 gap-1.5 text-md text-white hover:text-text-primary focus:outline-none focus:text-blue-500 cursor-pointer hover:bg-hover-green"
                >
                    <!-- Förstoringsglas-ikon -->
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>

                    <span>Sök</span>
                </button>
            </div>

            <span>Sortera på:</span>

            <!-- Filtrera på genre -->
            <label class="sr-only" for="genre">Välj genre:</label>
            <select name="genre" class="rounded-2xl border border-container-low-border bg-white py-2 px-2 text-md border-border-subtle bg-bg-surface text-sm text-text-primary focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" id="genre">
                <option value="">Alla genrer</option>
                @foreach (var g in Model.AvailableGenres)
                {
                    <option value="@g">@g</option>
                }
            </select>

            <!-- Filtrera på ålder -->
            <label class="sr-only" for="age">Välj åldersgrupp:</label>
            <select name="age" class="rounded-2xl border border-container-low-border bg-white py-2 px-2 text-md border-border-subtle bg-bg-surface text-sm text-text-primary focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" id="age">
                <option value="">Alla åldrar</option>
                @foreach (var a in Model.AvailableAges)
                {
                    <option value="@a">@a år</option>
                }
            </select>
        </form>
    </section>

    @if (Model.HasSearched)
    {
        <h2 class="mb-2 text-2xl font-bold text-on-surface">Sökresultat för @Model.CurrentSearchWord</h2>
            @if (Model.SearchResults.Any())
             {
                <section class="grid grid-cols-2 gap-4 md:grid-cols-[repeat(auto-fill,minmax(220px,1fr))] md:gap-8">
                    @foreach (var book in Model.SearchResults)
                    {
                        <article class="w-full rounded-4xl bg-white p-6 md:max-w-75 shadow-md">
                            <a href="/books/@book.BookId" class="block">
                                <div class="aspect-2/3 w-full overflow-hidden rounded-sm bg-gray-100 mb-4">
                                    <img 
                                        src="@book.CoverImage" 
                                        alt="Omslag för @book.Title" 
                                        class="h-full w-full object-cover" 
                                        loading="lazy" 
                                    />
                                </div>
                                <div class="flex flex-1 flex-col justify-between">
                                    <div>
                                        <h3 class="font-family text-xl font-bold text-on-surface line-clamp-2" title="@book.Title">
                                            @book.Title
                                        </h3>
                                        <p class="mt-1 text-sm text-on-surface-variant line-clamp-1">
                                            @(book.Authors.Any() 
                                                ? string.Join(", ", book.Authors.Select(a => $"{a.FirstName} {a.LastName}")) 
                                                : "Okänd författare")
                                        </p>
                                    </div>
                                </div>
                            </a>
                        </article>
                    }
                </section>
            }
            else
            {
                <p>Hittade ingen bok som passade din sökning.</p>
            }

            
    }


    <section>
        <h2 class="text-h2">Leta bland hyllorna</h2>
        <div class="grid grid-cols-2 gap-4 md:grid-cols-4 sm:gap-10 w-full">
            <a href="/?genre=Äventyr" class="flex flex-col items-center text-center border border-container-low-border bg-white p-8 text-md rounded-2xl hover:bg-primary"">
                <img src="/images/icons/trees.svg" alt="" class="" />
                <h3 class="text-lg line-clamp-2">Äventyr</h3>
            </a>

            <a href="/?genre=Deckare" class="flex flex-col items-center text-center flex-1 border border-container-low-border bg-white p-8 text-md rounded-2xl hover:bg-primary">
                <img src="/images/icons/hat-glasses.svg" alt="" class="" />
                <h3 class="text-lg line-clamp-2">Deckare</h3>
            </a>

            <a href="/?genre=Fantasy" class="flex flex-col items-center text-center flex-1 border border-container-low-border bg-white p-8 text-md rounded-2xl hover:bg-primary">
                <img src="/images/icons/swords.svg" alt="" class="" />
                <h3 class="text-lg line-clamp-2">Fantasy</h3>
            </a>

            <a href="/?genre=Humor" class="flex flex-col items-center text-center flex-1 border border-container-low-border bg-white p-8 text-md rounded-2xl hover:bg-primary">
                <img src="/images/icons/face-grinning.svg" alt="" class="" />
                <h3 class="text-lg line-clamp-2">Humor</h3>
            </a>
        </div>
    </section>

    <section>
        <h2 class="text-h2">Nya böcker</h2>
        <div class="grid grid-cols-2 gap-4 md:grid-cols-5 sm:gap-10 w-full">
            @foreach (var book in Model.LatestBooks)
                {
                    <article class="group w-full flex-1 border border-container-low-border bg-white p-4 text-md rounded-2xl">
                        <a href="/books/@book.BookId" class="block">
                            <div class="aspect-2/3 w-full overflow-hidden rounded-sm bg-gray-100">
                                <img 
                                    src="@book.CoverImage" 
                                    alt="Omslag för @book.Title" 
                                    class="h-full w-full object-cover transition-transform duration-300 ease-out group-hover:scale-110"
                                    loading="lazy" 
                                />
                            </div>
                        </a>
                    </article>
                }
        </div>
    </section>