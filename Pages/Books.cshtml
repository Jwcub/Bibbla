@page "/books/{BookId:int}"
@using Microsoft.EntityFrameworkCore.Metadata.Internal
@model eLibrary.Pages.Books.DetailsModel
@{
    ViewData["Title"] = Model.Book?.Title ?? "Bokdetaljer";
}

    <a href="" onClick="history.go(-1); return false;" class="flex gap-1 bg-hover self-start py-1 px-4 rounded-2xl hover:bg-secondary"> <img src="~/images/icons/arrow-left.svg" class="w-4 h-auto">Tillbaka till böcker</a>

    <section class="grid grid-cols-1 md:grid-cols-sidebar gap-10 bg-white p-4 md:p-12 rounded-lg shadow-md">
            <div>
                <img src="@Model.Book!.CoverImage" alt="Omslag @Model.Book.Title" />
            </div>

            <div class="flex flex-col gap-2">
                <div>
                    <h1 class="text-4xl font-bold tracking-tight">
                        @Model.Book.Title
                    </h1>
                </div>
                
                <div>
                    @if (Model.Book.Series != null)
                    {
                        <strong>Del @Model.Book.SeriesOrder: @Model.Book.Series</strong>
                    }
                    <p>
                        Av: @(Model.Book.Authors.Any()
                        ? string.Join(", ", Model.Book.Authors.Select(a => $"{a.FirstName} {a.LastName}"))
                        : "Okänd författare")
                    </p>
                </div>

                <div>
                    <h2 class="text-xl mb-2">
                        Vad handlar boken om?
                    </h2>
                    <p class="mt-2 mb-2 leading-relaxed">
                        @Model.Book.Description
                    </p>
                </div>

                <div>
                    @foreach (var genre in Model.Book.Genres)
                    {
                        <button class="bg-hover px-4 py-2 rounded-md text-xs">@genre.Name</button>
                    }
                </div>

                <div class="flex gap-2 items-center mt-4">
                    @if (@Model.Book.AvailableCopies > 0 && User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <form method="post" asp-page-handler="Borrow">
                            <input type="hidden" name="bookId" value="@Model.Book.BookId" />
                            <button type="submit" class="bg-primary px-4 py-2 rounded-md text-md font-bold text-white cursor-pointer hover:bg-hover-green">
                                Låna boken
                            </button>
                        </form>
                    } else if (Model.Book.AvailableCopies == 0 && User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <form method="post" asp-page-handler="Reserve">
                            <input type="hidden" name="bookId" value="@Model.Book.BookId" />
                            <button type="submit" class="bg-secondary px-4 py-2 rounded-md text-md font-bold text-white cursor-pointer hover:bg-hover">
                                Reservera boken
                            </button>
                        </form>
                    } else
                    {
                        <a href="/Login" class="bg-primary px-4 py-2 rounded-md text-md font-bold text-white cursor-pointer hover:bg-hover-green">Logga in för att låna bok</a>
                    }

                    <p>Antal tillgängliga: @Model.Book.AvailableCopies</p>
                    <div asp-validation-summary="ModelOnly" class="text-red-600 font-semibold mb-4"></div>
                </div>
            </div>
    </section>

