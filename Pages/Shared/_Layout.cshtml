@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/eLibrary.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

</head>
<body class="min-h-screen flex flex-col bg-background">
    <header class="w-full bg-surface bg-opacity-95 shadow-soft">
        <div class="max-w-container-max mx-auto h-16 px-4 sm:px-6 lg:px-8 flex items-center justify-between md:grid md:grid-cols-3">
            
            <!-- Logotyp -->
                <a href="/" class="flex items-center gap-2 text-on-surface hover:opacity-90 transition">
                    <img 
                        src="~/images/bibblalogo.svg" 
                        asp-append-version="true" 
                        alt="" 
                        style="width: 36px; height: 36px; display: block;" 
                    />

                    <div class="text-on-surface font-family">
                        <span class="font-bold text-lg">Bibbla</span>
                        <span>&nbsp;| Bergaskolan</span>
                    </div>
                </a>

            <!-- Meny desktop -->
            <nav class="hidden md:flex md:justify-center">
                <ul class="flex gap-6 text-on-surface text-base font-bold font-family tracking-wide whitespace-nowrap">
                    <li><a asp-page="/Index" class=" px-3 py-2 rounded-md hover:bg-hover font-bold transition @(currentPage == "/Index" ? "bg-secondary font-semibold" : "")">Sök böcker</a></li>

                    @if (User.IsInRole("admin"))
                    {
                        <li><a asp-page="/Admin" class="px-3 py-2 rounded-md hover:bg-hover font-bold transition @(currentPage == "/Admin" ? "bg-secondary font-semibold" : "")">Administration</a></li>
                    }
                    else
                    {
                       <li><a asp-page="/My-page" class="px-3 py-2 rounded-md hover:bg-hover font-bold transition @(currentPage == "/My-page" ? "bg-secondary font-semibold" : "")">Min sida</a></li> 
                    }
                    
                </ul>
            </nav>

            <!-- Hamburgermeny-knapp -->
            <div class="flex items-center justify-end">
                <button 
                    type="button" 
                    id="mobile-menu-btn"
                    aria-label="Öppna meny" 
                    aria-expanded="false"
                    class="md:hidden p-2 text-on-surface hover:bg-surface-container rounded-lg focus:outline-none focus:ring-2 focus:ring-primary">
                    
                    <svg id="icon-open" class="h-6 w-6 block" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                    </svg>
                    
                    <svg id="icon-close" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>

                <!-- Login / Logout-knapp desktop -->
                <div class="hidden md:block">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        @using System.Security.Claims
                        <span class="mr-4">@User.FindFirst(ClaimTypes.GivenName)?.Value</span>
                         
                        <form method="post" asp-page="/Logout" class="inline">
                            <button type="submit" 
                                    class="rounded-lg bg-buttons px-4 py-2 text-base font-medium text-white cursor-pointer transition hover:bg-hover-green hover:text-white">
                                Logga ut
                            </button>
                        </form>
                    } 
                    else
                    {
                        <a asp-page="/Login" 
                        class="rounded-lg bg-buttons px-4 py-2 text-base font-medium text-white transition hover:bg-hover-green hover:text-white">
                            Logga in
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- Mobilmeny (Dropdown) -->
        <div id="mobile-menu" class="hidden md:hidden border-t border-outline-variant bg-surface px-4 pt-3 pb-5 space-y-4">
            <nav>
                <ul class="flex flex-col gap-3 text-base font-medium text-on-surface">
                    <li><a asp-page="/Index" class="hover:text-primary transition">Sök böcker</a></li>
                    <li><a asp-page="/My-page" class="hover:text-primary transition">Mina sida</a></li>
                </ul>
            </nav>

            <div class="pt-3 border-t border-outline-variant">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <form method="post" asp-page="/Account/Logout" class="block">
                        <button type="submit" 
                                class="w-full text-center rounded-lg bg-buttons px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-200">
                            Logga ut
                        </button>
                    </form>
                } 
                else
                {
                    <a asp-page="/Account/Login" 
                    class="block w-full text-center rounded-lg bg-buttons px-3.5 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-hover">
                        Logga in
                    </a>
                }
            </div>
        </div>
    </header>

     <main role="main" class="flex-1 p-2 sm:py-4 md:py-10">
        <div class="max-w-240 mx-auto w-full flex flex-col px-4 sm:px-6 lg:px-8 gap-5">
            @RenderBody()
        </div>
    </main>
   
    <footer class="bg-surface-container">
        <div class="max-w-container-max w-full flex flex-col items-center justify-center gap-2 bg-surface-container-low p-8 sm:px-6 lg:px-8">
            <span>&copy; 2026</span>
            <span class="font-bold">Bergaskolan</span>
            <a href="/" class="flex items-center gap-2 text-on-surface hover:opacity-90 transition">
                <img 
                    src="~/images/bibblalogo.svg" 
                    asp-append-version="true" 
                    alt="" 
                    style="width: 36px; height: 36px; display: block;" 
                />

                <div class="text-on-surface font-family">
                    <span class="font-bold text-lg">Bibbla</span>
                </div>
            </a>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<!-- Meny script -->
<script>
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('icon-open');
    const iconClose = document.getElementById('icon-close');

    btn.addEventListener('click', () => {
        const isOpen = !menu.classList.contains('hidden');
        menu.classList.toggle('hidden');
        iconOpen.classList.toggle('hidden');
        iconClose.classList.toggle('hidden');
        btn.setAttribute('aria-expanded', !isOpen);
    });
</script>